# Cloudinary — media delivery (videos, and any images we don't ship from `public/`).
# Copy to `.env.local` and fill in. `.env.local` is git-ignored; this file is not.

# Public: the cloud name appears in every delivery URL, so it is safe in the client bundle.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Server-only, for the Admin/Upload APIs (uploading art, listing assets, signed URLs).
# Delivery does NOT need these. Never prefix them with NEXT_PUBLIC_ — that ships them to the browser.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
